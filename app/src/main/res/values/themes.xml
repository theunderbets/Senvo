<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Custom attributes for semantic colors -->
    <attr name="senvoBg" format="color" />
    <attr name="senvoSurface" format="color" />
    <attr name="senvoSurface2" format="color" />
    <attr name="senvoLine" format="color" />
    <attr name="senvoText" format="color" />
    <attr name="senvoTextDim" format="color" />
    <attr name="senvoAccent" format="color" />

    <!-- Risk tier colors -->
    <attr name="senvoRiskNormal" format="color" />
    <attr name="senvoRiskWatch" format="color" />
    <attr name="senvoRiskAlert" format="color" />
    <attr name="senvoRiskEmergency" format="color" />

    <!-- Hazard colors -->
    <attr name="senvoHazardHeat" format="color" />
    <attr name="senvoHazardAqi" format="color" />
    <attr name="senvoHazardFlood" format="color" />
    <attr name="senvoHazardCyclone" format="color" />

    <!-- Base application theme - Dark (default) -->
    <style name="Theme.Senvo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Custom color palette -->
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorPrimaryVariant">#004D40</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/dark_accent</item>
        <item name="colorSecondaryVariant">#004D40</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnBackground">@color/dark_text</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorError">@color/risk_alert_dark</item>
        <item name="colorOnError">@color/white</item>

        <!-- Custom attributes for semantic colors -->
        <item name="senvoBg">@color/dark_bg</item>
        <item name="senvoSurface">@color/dark_surface</item>
        <item name="senvoSurface2">@color/dark_surface_2</item>
        <item name="senvoLine">@color/dark_line</item>
        <item name="senvoText">@color/dark_text</item>
        <item name="senvoTextDim">@color/dark_text_dim</item>
        <item name="senvoAccent">@color/dark_accent</item>

        <!-- Risk tier colors -->
        <item name="senvoRiskNormal">@color/risk_normal_dark</item>
        <item name="senvoRiskWatch">@color/risk_watch_dark</item>
        <item name="senvoRiskAlert">@color/risk_alert_dark</item>
        <item name="senvoRiskEmergency">@color/risk_emergency_dark</item>

        <!-- Hazard colors -->
        <item name="senvoHazardHeat">@color/hazard_heat_dark</item>
        <item name="senvoHazardAqi">@color/hazard_aqi_dark</item>
        <item name="senvoHazardFlood">@color/hazard_flood_dark</item>
        <item name="senvoHazardCyclone">@color/hazard_cyclone_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Senvo.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Senvo.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Senvo.LargeComponent</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Senvo.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Senvo.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Senvo.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Senvo.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Senvo.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Senvo.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Senvo.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Senvo.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Senvo.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Senvo.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Senvo.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Senvo.LabelSmall</item>
    </style>

    <!-- Light theme override -->
    <style name="Theme.Senvo.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/light_accent</item>
        <item name="colorPrimaryVariant">@color/light_accent</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/light_accent</item>
        <item name="colorSecondaryVariant">@color/light_accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/light_bg</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnBackground">@color/light_text</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorError">@color/risk_alert_light</item>
        <item name="colorOnError">@color/white</item>

        <item name="senvoBg">@color/light_bg</item>
        <item name="senvoSurface">@color/light_surface</item>
        <item name="senvoSurface2">@color/light_surface_2</item>
        <item name="senvoLine">@color/light_line</item>
        <item name="senvoText">@color/light_text</item>
        <item name="senvoTextDim">@color/light_text_dim</item>
        <item name="senvoAccent">@color/light_accent</item>

        <item name="senvoRiskNormal">@color/risk_normal_light</item>
        <item name="senvoRiskWatch">@color/risk_watch_light</item>
        <item name="senvoRiskAlert">@color/risk_alert_light</item>
        <item name="senvoRiskEmergency">@color/risk_emergency_light</item>

        <item name="senvoHazardHeat">@color/hazard_heat_light</item>
        <item name="senvoHazardAqi">@color/hazard_aqi_light</item>
        <item name="senvoHazardFlood">@color/hazard_flood_light</item>
        <item name="senvoHazardCyclone">@color/hazard_cyclone_light</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Emergency/SOS theme - Fixed dark red, ignores system theme -->
    <style name="Theme.Senvo.Emergency" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/risk_emergency_dark</item>
        <item name="colorPrimaryVariant">@color/risk_emergency_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="android:colorBackground">@color/risk_emergency_dark</item>
        <item name="colorSurface">@color/risk_emergency_dark</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorError">@color/white</item>

        <item name="android:statusBarColor">@color/risk_emergency_dark</item>
        <item name="android:navigationBarColor">@color/risk_emergency_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- NoActionBar variant for activities that need custom toolbars -->
    <style name="Theme.Senvo.NoActionBar" parent="Theme.Senvo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ===== SHAPE APPEARANCES ===== -->
    <style name="ShapeAppearance.Senvo.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Senvo.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Senvo.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Card shape (14-16dp) -->
    <style name="ShapeAppearance.Senvo.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Pill button shape -->
    <style name="ShapeAppearance.Senvo.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">100dp</item>
    </style>

    <!-- ===== TYPOGRAPHY ===== -->
    <!-- Space Grotesk for display/headings -->
    <style name="TextAppearance.Senvo.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="fontWeight">700</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Senvo.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="fontWeight">700</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Senvo.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="fontWeight">700</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Senvo.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="fontWeight">600</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Senvo.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="fontWeight">600</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Senvo.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="fontWeight">600</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Inter for body/UI -->
    <style name="TextAppearance.Senvo.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">400</item>
    </style>

    <style name="TextAppearance.Senvo.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">400</item>
    </style>

    <style name="TextAppearance.Senvo.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">400</item>
    </style>

    <style name="TextAppearance.Senvo.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontWeight">600</item>
    </style>

    <style name="TextAppearance.Senvo.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontWeight">600</item>
    </style>

    <style name="TextAppearance.Senvo.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontWeight">600</item>
    </style>

    <!-- Hindi/Odia text appearances -->
    <style name="TextAppearance.Senvo.Hindi" parent="TextAppearance.Senvo.BodyMedium">
        <item name="fontFamily">@font/noto_sans_devanagari</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontWeight">500</item>
    </style>

    <style name="TextAppearance.Senvo.Odia" parent="TextAppearance.Senvo.BodyMedium">
        <item name="fontFamily">@font/noto_sans_oriya</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontWeight">500</item>
    </style>

    <declare-styleable name="SenvoCard">
        <attr name="riskTier" format="enum">
            <enum name="normal" value="0"/>
            <enum name="watch" value="1"/>
            <enum name="alert" value="2"/>
            <enum name="emergency" value="3"/>
        </attr>
        <attr name="hazardType" format="enum">
            <enum name="heat" value="0"/>
            <enum name="aqi" value="1"/>
            <enum name="flood" value="2"/>
            <enum name="cyclone" value="3"/>
        </attr>
    </declare-styleable>
</resources>